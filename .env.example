# Brand & Application Settings (No personal name required)
APP_TITLE="StrongHire"
INTERVIEWER_NAME="StrongHire"
INTERVIEWER_HEADLINE="1-on-1 SWE Mock Interviews & Personalized Study Plans"
BASE_URL="http://localhost:8000"
DATABASE_PATH="interviews.db"
HOST_TIMEZONE="Europe/Rome"

# Admin Authentication & Security
ADMIN_PASSWORD="admin"
ADMIN_SECRET="super-secret-interviewer-key"
ADMIN_EMAIL="coach@example.com"

# Session Pricing & Payment Links (Revolut Pro Merchant API + Webhook Auto-Confirmation)
SESSION_PRICE_DISPLAY="€50"
SESSION_DURATION_MINUTES="60"
REVOLUT_PAYMENT_URL="https://revolut.me/federim7n9"
REVOLUT_API_KEY=""
REVOLUT_WEBHOOK_SECRET="wsk_dev_mock_webhook_secret_key"
REVOLUT_API_BASE="https://sandbox-merchant.revolut.com"
REVOLUT_API_VERSION="2024-09-01"
TRUST_PROXY_HEADERS="false"

# Gmail SMTP Configuration (Leave SMTP_APP_PASSWORD empty for local console preview mode)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="coach@example.com"
SMTP_APP_PASSWORD=""
SMTP_DOMAIN="gmail.com"

# Google Calendar OAuth2 Files (Optional locally — falls back to manual/simulated Meet link if missing)
GOOGLE_CLIENT_SECRETS_FILE="credentials.json"
GOOGLE_TOKEN_FILE="token.json"
GOOGLE_CALENDAR_ID="primary"
